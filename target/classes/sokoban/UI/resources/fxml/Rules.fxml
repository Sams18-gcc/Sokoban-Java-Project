<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<?import javafx.geometry.Insets?>
<StackPane fx:id="ROOT" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="sokoban.UI.controller.RulesController">
    <ImageView fx:id="background" pickOnBounds="true" preserveRatio="false"/>
    <VBox stylesheets="@../style/Rules.css" spacing="15" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
        </padding>
        <!-- TOP: BACK à gauche -->
        <HBox alignment="CENTER_LEFT">
            <Button fx:id="BACKbutton" onMouseEntered="#mouseEnterBack" onMouseExited="#mouseExitBack" mnemonicParsing="false" onAction="#BackAction">
                <graphic>
                    <ImageView fx:id="backImage" fitHeight="60.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true"/>
                </graphic>
            </Button>
        </HBox>
        <Region VBox.vgrow="NEVER" prefHeight="150"/>

        <!-- RULES VIEW centré -->
        <HBox alignment="CENTER">
            <ImageView fx:id="RulesView" fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true"/>
        </HBox>

        <!-- REGLES centrées -->
        <HBox alignment="CENTER" spacing="10">
            <ImageView fx:id="view1" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true"/>
            <Text fx:id="text1" fill="WHITE" wrappingWidth="500" text="Le joueur ne peut que pousser les caisses, jamais les tirer."/>
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <ImageView fx:id="view2" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true"/>
            <Text fx:id="text2" fill="#f5f2f2" wrappingWidth="500" text="Une caisse ne peut être poussée que vers une case libre (pas contre un mur ou une autre caisse)."/>
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <ImageView fx:id="view3" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true"/>
            <Text fx:id="text3" fill="#fffbfb" wrappingWidth="500" text="Le joueur se déplace case par case horizontalement ou verticalement (pas de diagonale)."/>
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <ImageView fx:id="view4" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true"/>
            <Text fx:id="text4" fill="#f5f0f0" wrappingWidth="500" text="Le niveau est réussi lorsque toutes les caisses sont placées sur les emplacements cibles."/>
        </HBox>

        <!-- SECTION BAS -->
        <HBox alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="sous_titre1" text="Déplacement"/>
                <ImageView fx:id="wasdView" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true"/>
                <Text fx:id="sous_text1" fill="WHITE" text="utilise WASD pour bouger." wrappingWidth="180"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="sous_titre2" text="Le box"/>
                <ImageView fx:id="BoxView" fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true"/>
                <Text fx:id="sous_text2" fill="WHITE" text="c'est l'objet que tu dois déplacer." wrappingWidth="180"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="sous_titre3" text="Ton personnage"/>
                <ImageView fx:id="PionView" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true"/>
                <Text fx:id="sous_text3" fill="WHITE" text="ce caractère te représente dans le jeu." wrappingWidth="180"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="sous_titre4" text="La cible"/>
                <ImageView fx:id="TargetView" fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true"/>
                <Text fx:id="sous_text4" fill="WHITE" text="c'est l'endroit où tu dois poser ton box." wrappingWidth="180"/>
            </VBox>
        </HBox>

    </VBox>
</StackPane>