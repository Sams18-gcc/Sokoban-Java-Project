<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="SCENE" prefHeight="690.0" prefWidth="900.0" stylesheets="@../style/InterfaceStyle.css"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="sokoban.UI.controller.InterfaceController">
   <children>
      <MediaView fx:id="BackgroundVideo"/>
      <VBox alignment="CENTER" spacing="10">
         <children>
            <Label fx:id="TITRE" alignment="CENTER" contentDisplay="CENTER" prefHeight="46.0" prefWidth="319.0"
                   text="SOKOBAN">
               <font>
                  <Font name="Bell MT" size="45.0"/>
               </font>
            </Label>
            <StackPane prefWidth="264.0" maxWidth="264.0">
               <children>
                  <Button fx:id="buttonSTART" alignment="CENTER" mnemonicParsing="false" onAction="#start"
                          onMouseEntered="#AFFICHESKULL" onMouseExited="#CAHCERSKULL" prefHeight="25.0"
                          prefWidth="264.0" text="START"/>
                  <ImageView fx:id="skull1" fitHeight="17.0" fitWidth="26.0" pickOnBounds="true"
                             StackPane.alignment="CENTER_RIGHT" preserveRatio="true" mouseTransparent="true">
                     <StackPane.margin><Insets right="10.0"/></StackPane.margin>
                  </ImageView>
               </children>
            </StackPane>
            <StackPane prefWidth="264.0" maxWidth="264.0">
               <children>
                  <Button fx:id="buttonSETTINGS" alignment="CENTER" mnemonicParsing="false" onAction="#settings"
                          onMouseEntered="#AFFICHESKULL" onMouseExited="#CAHCERSKULL" prefHeight="25.0"
                          prefWidth="264.0" text="SETTINGS"/>
                  <ImageView fx:id="skull2" fitHeight="17.0" fitWidth="26.0" pickOnBounds="true"
                             StackPane.alignment="CENTER_RIGHT" preserveRatio="true" mouseTransparent="true">
                     <StackPane.margin><Insets right="10.0"/></StackPane.margin>
                  </ImageView>
               </children>
            </StackPane>
            <StackPane prefWidth="264.0" maxWidth="264.0">
               <children>
                  <Button fx:id="buttonRULES" mnemonicParsing="false" onAction="#rules"
                          onMouseEntered="#AFFICHESKULL" onMouseExited="#CAHCERSKULL" prefHeight="25.0"
                          prefWidth="264.0" text="RULES"/>
                  <ImageView fx:id="skull3" fitHeight="17.0" fitWidth="26.0" pickOnBounds="true"
                             StackPane.alignment="CENTER_RIGHT" preserveRatio="true" mouseTransparent="true">
                     <StackPane.margin><Insets right="10.0"/></StackPane.margin>
                  </ImageView>
               </children>
            </StackPane>
            <StackPane prefWidth="264.0" maxWidth="264.0">
               <children>
                  <Button fx:id="buttonEDITOR" mnemonicParsing="false" onAction="#editor"
                          onMouseEntered="#AFFICHESKULL" onMouseExited="#CAHCERSKULL" prefHeight="25.0"
                          prefWidth="264.0" text="EDITOR"/>
                  <ImageView fx:id="skull4" fitHeight="17.0" fitWidth="26.0" pickOnBounds="true"
                             StackPane.alignment="CENTER_RIGHT" preserveRatio="true" mouseTransparent="true">
                     <StackPane.margin><Insets right="10.0"/></StackPane.margin>
                  </ImageView>
               </children>
            </StackPane>
            <StackPane prefWidth="264.0" maxWidth="264.0">
               <children>
                  <Button fx:id="buttonEXIT" mnemonicParsing="false" onAction="#exit"
                          onMouseEntered="#AFFICHESKULL" onMouseExited="#CAHCERSKULL" prefHeight="25.0"
                          prefWidth="264.0" text="EXIT"/>
                  <ImageView fx:id="skull5" fitHeight="17.0" fitWidth="26.0" pickOnBounds="true"
                             StackPane.alignment="CENTER_RIGHT" preserveRatio="true" mouseTransparent="true">
                     <StackPane.margin><Insets right="10.0"/></StackPane.margin>
                  </ImageView>
               </children>
            </StackPane>
         </children>
      </VBox>
   </children>
</StackPane>